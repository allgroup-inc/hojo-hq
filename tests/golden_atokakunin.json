{
  "_comment": "後確認 判定ロジックのゴールデンセット。scripts/atokakunin_rules.py --self-test が読む。個人情報は含まない(tel_keyは仮名化済みの不透明キー)。設計根拠: docs/後確認SMS_質問リスト_2026-08-14.md §B",
  "version": 1,

  "reply_judgment": [
    {"name": "完全一致の「はい」は承認", "text": "はい", "expect": "承認"},
    {"name": "前後の半角空白は落として承認", "text": "  はい ", "expect": "承認"},
    {"name": "前後の全角空白も落として承認", "text": "　はい　", "expect": "承認"},
    {"name": "改行付きでも承認", "text": "はい\n", "expect": "承認"},
    {"name": "句点付きは要確認(完全一致ではない)", "text": "はい。", "expect": "要確認"},
    {"name": "丁寧な言い回しは要確認", "text": "はい、お願いします", "expect": "要確認"},
    {"name": "カタカナは要確認(既定では承認語に含めない)", "text": "ハイ", "expect": "要確認"},
    {"name": "質問が来たら要確認", "text": "内容について質問があります", "expect": "要確認"},
    {"name": "否定は当然に要確認", "text": "いいえ", "expect": "要確認"},
    {"name": "空文字は要確認", "text": "", "expect": "要確認"},
    {"name": "空白だけは要確認", "text": "   ", "expect": "要確認"},
    {"name": "未受信(None)は要確認", "text": null, "expect": "要確認"},
    {"name": "「はい」を含むだけの長文は承認しない", "text": "はいはい了解です", "expect": "要確認"}
  ],

  "auto_approve": [
