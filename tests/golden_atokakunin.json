    {"name": "同じ番号で未完了3件なら自動承認しない", "tel_key": "T-aaa", "open_tel_keys": ["T-aaa", "T-aaa", "T-aaa"], "expect": false},
    {"name": "別番号が何件あっても影響しない", "tel_key": "T-aaa", "open_tel_keys": ["T-aaa", "T-bbb", "T-ccc"], "expect": true},
    {"name": "未完了が0件でも自動承認は妨げない", "tel_key": "T-zzz", "open_tel_keys": [], "expect": true}
